{
  "name": "sluicify-native",
  "version": "0.3.0",
  "description": "Native Node.js addon for sluicify (AF_UNIX command broker).",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "repository": "github:clbrge/sluicify",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "src/",
    "build.rs",
    "Cargo.toml"
  ],
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "napi": {
    "name": "sluicify-native",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  }
}
